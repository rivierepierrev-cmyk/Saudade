{
  "name": "foliole",
  "productName": "Foliole",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --external:vite --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --outfile=dist-electron/server.mjs",
    "electron:dev": "npm run build && npm run build:server && electron .",
    "dist:linux": "npm run build && npm run build:server && electron-builder --linux deb AppImage",
    "dist:deb": "npm run build && npm run build:server && electron-builder --linux deb",
    "dist:appimage": "npm run build && npm run build:server && electron-builder --linux AppImage",
    "lint": "tsc --noEmit",
    "test": "node tests/store.test.cjs",
    "dist:win": "npm run build && npm run build:server && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "marked": "^18.1.1",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "concurrently": "^9.1.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "app.foliole.desktop",
    "productName": "Foliole",
    "desktopName": "foliole.desktop",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "linux": {
      "category": "Office",
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icon.png",
      "maintainer": "Foliole <foliole@localhost>"
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "Foliole-${version}-${os}-${arch}.${ext}"
  },
  "description": "Lecture incrémentale et répétition espacée FSRS — 100 % local, sans IA",
  "author": "Foliole"
}