{
  "name": "saudade",
  "productName": "Saudade",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "saudade.desktop",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --external:vite --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --outfile=dist-electron/server.mjs",
    "electron:dev": "npm run build && npm run build:server && electron .",
    "dist:linux": "npm run build && npm run build:server && electron-builder --publish never --linux deb AppImage",
    "dist:deb": "npm run build && npm run build:server && electron-builder --publish never --linux deb",
    "dist:appimage": "npm run build && npm run build:server && electron-builder --publish never --linux AppImage",
    "lint": "tsc --noEmit",
    "test": "node tests/store.test.cjs && tsx tests/cloze.test.ts && tsx tests/search.test.ts && tsx tests/math.test.ts && tsx tests/sync.test.ts && tsx tests/notes.test.ts && tsx tests/cards.test.ts && tsx tests/syncmodel.test.ts && node tests/syncfolder.test.cjs",
    "dist:win": "npm run build && npm run build:server && electron-builder --publish never --win nsis portable",
    "test:e2e": "npm run build && npm run build:server && npm run build:mobile && node tests/e2e/run.cjs",
    "build:mobile": "vite build --mode mobile --outDir dist-mobile"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^9.1.0",
    "dompurify": "^3.4.17",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "katex": "^0.19.1",
    "lucide-react": "^0.546.0",
    "marked": "^18.1.1",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.63.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "ts-fsrs": "^5.4.2",
    "tsx": "^4.21.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "app.saudade.desktop",
    "productName": "Saudade",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "linux": {
      "category": "Office",
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icon.png",
      "maintainer": "Saudade <saudade@localhost>",
      "executableName": "saudade",
      "synopsis": "Lecture incrémentale et répétition espacée",
      "desktop": {
        "entry": {
          "Keywords": "lecture;révision;flashcards;FSRS;"
        }
      },
      "syncDesktopName": true
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "Saudade-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "rivierepierrev-cmyk",
        "repo": "Saudade",
        "releaseType": "release"
      }
    ],
    "deb": {
      "fpm": [
        "--replaces=gemma",
        "--conflicts=gemma",
        "--provides=gemma",
        "--replaces=foliole",
        "--conflicts=foliole",
        "--provides=foliole"
      ]
    }
  },
  "description": "Lecture incrémentale et répétition espacée FSRS — 100 % local, sans IA",
  "homepage": "https://github.com/rivierepierrev-cmyk/saudade",
  "author": "Saudade",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rivierepierrev-cmyk/saudade.git"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "electron-updater": "^6.8.11",
    "scrypt-js": "^3.0.1"
  }
}
